      "type": "string"
    },
    {
      "key": "DOCUMENT_URL_TEMPLATE",
      "value": "",
      "type": "string",
      "description": "Optional. Example template: https://example.com/document/{{documentNumber}}.pdf. Leave blank until the real PDF/detail URL pattern is known."
    },
    {
      "key": "parsed_table_json",
      "value": "",
      "type": "string"
    },
    {
