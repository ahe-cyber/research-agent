{
  "info": {
    "_postman_id": "43091ecc-6466-49a2-8811-9813124304d0",
    "name": "GIS Source Flow Demo - Richmond County Clerk",
    "description": "Demonstrates using a Postman collection as an external_flow/source backend for a GIS research app.\n\nFlow: receive block/lot as runtime variables, request the Richmond County Clerk block/lot HTML result page, parse the result table, normalize rows into document records, store intermediate collection variables, and emit a final JSON object with the __SOURCE_RESULT__ marker for an Express wrapper to capture from Postman CLI stdout.\n\nReplace DOCUMENT_URL_TEMPLATE when you know the exact PDF/detail URL pattern. The template can use {{documentNumber}}, {{block}}, {{lot}}, {{recordedDate}}, {{documentType}}, or any table header name.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Richmond County Clerk - Block/Lot HTML to Documents JSON",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('Running Richmond County Clerk source flow', { block: pm.variables.get('block'), lot: pm.variables.get('lot') });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cheerio = require(\"cheerio\");",
              "",
              "const html = pm.response.text();",
              "const $ = cheerio.load(html);",
              "",
              "function cleanText(value) {",
              "  return String(value || \"\")",
              "    .replace(/\\u00a0/g, \" \")",
              "    .replace(/\\s+/g, \" \")",
              "    .trim();",
              "}",
              "",
              "function normalizeKey(value) {",
              "  return cleanText(value)",
              "    .toLowerCase()",
              "    .replace(/[^a-z0-9]+/g, \"_\")",
              "    .replace(/^_+|_+$/g, \"\");",
              "}",
              "",
              "function uniqueHeaders(headers) {",
              "  const seen = {};",
              "  return headers.map((header, index) => {",
              "    const base = cleanText(header) || `column_${index}`;",
              "    const normalized = normalizeKey(base) || `column_${index}`;",
              "    seen[normalized] = (seen[normalized] || 0) + 1;",
              "    return seen[normalized] === 1 ? base : `${base}_${seen[normalized]}`;",
              "  });",
              "}",
              "",
              "function tableToObjects(selector = \"table\") {",
              "  const $table = $(selector).first();",
              "",
              "  if (!$table.length) {",
              "    return [];",
              "  }",
              "",
              "  const rows = [];",
              "",
              "  $table.find(\"tr\").each((_, tr) => {",
              "    const cells = $(tr)",
              "      .children(\"th, td\")",
              "      .map((_, cell) => cleanText($(cell).text()))",
              "      .get();",
              "",
              "    if (cells.length > 0) {",
              "      rows.push(cells);",
              "    }",
              "  });",
              "",
              "  if (rows.length === 0) {",
              "    return [];",
              "  }",
              "",
              "  const headers = uniqueHeaders(rows[0]);",
              "",
              "  return rows.slice(1).map((row, rowIndex) => {",
              "    const item = {",
              "      _rowIndex: rowIndex",
              "    };",
              "",
              "    headers.forEach((header, index) => {",
              "      item[header] = row[index] || \"\";",
              "    });",
              "",
              "    return item;",
              "  });",
              "}",
              "",
              "// Fallback for simple pages whose tabular content is not actually inside <table> tags.",
              "// This is tuned for Richmond County Clerk's block/lot result shape:",
              "// BLOCK LOT BOOK PAGE RECORDED TYPE NUMBER",
              "function richmondTextFallback() {",
              "  const text = $(\"body\").text().replace(/\\u00a0/g, \" \");",
              "  const lines = text",
              "    .split(/\\r?\\n/)",
              "    .map(cleanText)",
              "    .filter(Boolean);",
              "",
              "  const startIndex = lines.findIndex(line => /BLOCK\\s+LOT\\s+BOOK\\s+PAGE\\s+RECORDED\\s+TYPE\\s+NUMBER/i.test(line));",
              "  if (startIndex === -1) return [];",
              "",
              "  const records = [];",
              "  for (const line of lines.slice(startIndex + 1)) {",
              "    if (/Search Menu|New Search|Copyright/i.test(line)) break;",
              "",
              "    // Newer rows often omit BOOK/PAGE, older rows include them.",
              "    // Capture: block lot [book page] recorded type number",
              "    const match = line.match(/^(\\d+)\\s+(\\d+)\\s+(?:(\\d+)\\s+(\\d+)\\s+)?(\\d{1,2}\\/\\d{1,2}\\/\\d{4})\\s+(.+?)\\s+(\\d+)$/);",
              "    if (!match) continue;",
              "",
              "    records.push({",
              "      _rowIndex: records.length,",
              "      BLOCK: match[1],",
              "      LOT: match[2],",
              "      BOOK: match[3] || \"\",",
              "      PAGE: match[4] || \"\",",
              "      RECORDED: match[5],",
              "      TYPE: cleanText(match[6]),",
              "      NUMBER: match[7]",
              "    });",
              "  }",
              "",
              "  return records;",
              "}",
              "",
              "function getFieldValue(row, configuredField, candidates) {",
              "  if (configuredField && Object.prototype.hasOwnProperty.call(row, configuredField)) {",
              "    return cleanText(row[configuredField]);",
              "  }",
              "",
              "  const normalizedToKey = {};",
              "  Object.keys(row).forEach(key => {",
              "    normalizedToKey[normalizeKey(key)] = key;",
              "  });",
              "",
              "  for (const candidate of candidates) {",
              "    const key = normalizedToKey[normalizeKey(candidate)];",
              "    if (key && row[key] !== undefined) {",
              "      return cleanText(row[key]);",
              "    }",
              "  }",
              "",
              "  return \"\";",
              "}",
              "",
              "function fillTemplate(template, row, extra = {}) {",
              "  if (!template) return null;",
              "",
              "  const lookup = { ...extra };",
              "",
              "  Object.entries(row).forEach(([key, value]) => {",
              "    lookup[key] = value;",
              "    lookup[normalizeKey(key)] = value;",
              "  });",
              "",
              "  return template.replace(/{{\\s*([^}]+)\\s*}}/g, (_, rawKey) => {",
              "    const key = cleanText(rawKey);",
              "    const value = lookup[key] !== undefined ? lookup[key] : lookup[normalizeKey(key)];",
              "    return encodeURIComponent(value === undefined || value === null ? \"\" : String(value));",
              "  });",
              "}",
              "",
              "const sourceId = pm.variables.get(\"SOURCE_ID\") || \"richmond-county-clerk\";",
              "const tableSelector = pm.variables.get(\"TABLE_SELECTOR\") || \"table\";",
              "const documentNumberField = pm.variables.get(\"DOCUMENT_NUMBER_FIELD\") || \"NUMBER\";",
              "const documentUrlTemplate = pm.variables.get(\"DOCUMENT_URL_TEMPLATE\") || \"\";",
              "",
              "let tableObjects = tableToObjects(tableSelector);",
              "",
              "if (tableObjects.length === 0) {",
              "  tableObjects = richmondTextFallback();",
              "}",
              "",
              "const records = tableObjects.map(row => {",
              "  const documentNumber = getFieldValue(row, documentNumberField, [",
              "    \"NUMBER\",",
              "    \"DOCUMENT NUMBER\",",
              "    \"Doc Number\",",
              "    \"Document No\",",
              "    \"Instrument Number\",",
              "    \"Instrument No\"",
              "  ]);",
              "",
              "  const recordedDate = getFieldValue(row, \"\", [\"RECORDED\", \"Recorded\", \"Recorded Date\", \"Date\"]);",
              "  const documentType = getFieldValue(row, \"\", [\"TYPE\", \"Document Type\", \"Type\"]);",
              "  const block = getFieldValue(row, \"\", [\"BLOCK\", \"Block\"]);",
              "  const lot = getFieldValue(row, \"\", [\"LOT\", \"Lot\"]);",
              "",
              "  const documentUrl = fillTemplate(documentUrlTemplate, row, {",
              "    documentNumber,",
              "    recordedDate,",
              "    documentType,",
              "    block,",
              "    lot",
              "  });",
              "",
              "  return {",
              "    ...row,",
              "    documentNumber,",
              "    recordedDate,",
              "    documentType,",
              "    block,",
              "    lot,",
              "    documentUrl",
              "  };",
              "});",
              "",
              "const result = {",
              "  type: \"documents\",",
              "  sourceId,",
              "  records,",
              "  documents: records",
              "    .filter(record => record.documentNumber)",
              "    .map(record => ({",
              "      title: record.documentType",
              "        ? `${record.documentType} ${record.documentNumber}`",
              "        : `Document ${record.documentNumber}`,",
              "      documentNumber: record.documentNumber,",
              "      recordedDate: record.recordedDate,",
              "      documentType: record.documentType,",
              "      url: record.documentUrl,",
              "      mimeType: record.documentUrl && record.documentUrl.toLowerCase().includes(\".pdf\")",
              "        ? \"application/pdf\"",
              "        : null,",
              "      sourceRecord: record",
              "    })),",
              "  meta: {",
              "    sourceUrl: pm.request.url.toString(),",
              "    block: pm.variables.get(\"block\") || null,",
              "    lot: pm.variables.get(\"lot\") || null,",
              "    tableSelector,",
              "    rowCount: records.length,",
              "    generatedAt: new Date().toISOString()",
              "  }",
              "};",
              "",
              "// Intermediate variables for debugging inside Postman.",
              "pm.collectionVariables.set(\"parsed_table_json\", JSON.stringify(tableObjects));",
              "pm.collectionVariables.set(\"parsed_table_json_pretty\", JSON.stringify(tableObjects, null, 2));",
              "pm.collectionVariables.set(\"parsed_table_row_count\", String(tableObjects.length));",
              "pm.collectionVariables.set(\"document_records_json\", JSON.stringify(records));",
              "pm.collectionVariables.set(\"source_result_json\", JSON.stringify(result));",
              "",
              "// Final app/CLI contract. Express should extract this line from Postman CLI stdout.",
              "console.log(\"__SOURCE_RESULT__\" + JSON.stringify(result));",
              "",
              "pm.visualizer.set(",
              "  `<pre style=\"white-space: pre-wrap; font-size: 12px;\">{{json}}</pre>`,",
              "  { json: JSON.stringify(result, null, 2) }",
              ");",
              "",
              "pm.test(\"Parsed Richmond County Clerk result into normalized source result\", function () {",
              "  pm.expect(result.records).to.be.an(\"array\");",
              "  pm.expect(result.meta.rowCount).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
            "type": "text"
          }
        ],
        "url": {
          "raw": "https://www.richmondcountyclerk.com/Search/ShowResultsBlocks?Block={{block}}&Lot={{lot}}&SelectedDocumentIdentifier={{selectedDocumentIdentifier}}",
          "protocol": "https",
          "host": [
            "www",
            "richmondcountyclerk",
            "com"
          ],
          "path": [
            "Search",
            "ShowResultsBlocks"
          ],
          "query": [
            {
              "key": "Block",
              "value": "{{block}}"
            },
            {
              "key": "Lot",
              "value": "{{lot}}"
            },
            {
              "key": "SelectedDocumentIdentifier",
              "value": "{{selectedDocumentIdentifier}}"
            }
          ]
        },
        "description": "Fetches the Richmond County Clerk block/lot search result page and converts the HTML result table into a normalized documents payload. Run with Postman CLI and pass --env-var block=3692 --env-var lot=23, or edit collection variables."
      },
      "response": []
    }
  ],
