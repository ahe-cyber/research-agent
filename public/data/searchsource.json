{
  "sources": [
    {
      "id": "src-geosearch",
      "label": "NYC GeoSearch",
      "type": "geosearch",
      "costly": false,
      "description": "Searches NYC addresses and places using the NYC GeoSearch API.",
      "outputs": [
        { "variable": "selectedCoordinates", "path": "features.0.geometry.coordinates" },
        { "variable": "selectedAddress", "path": "features.0.properties.label" }
      ]
    },
    {
      "id": "src-mapbox",
      "label": "Mapbox Search",
      "type": "mapbox",
      "costly": true,
      "description": "Selected address or place from the Mapbox Search Box component.",
      "outputs": [
        { "variable": "selectedCoordinates", "path": "features.0.geometry.coordinates" },
        { "variable": "selectedAddress", "path": "features.0.properties.full_address" }
      ]
    },
    {
      "id": "src-google",
      "label": "Google Places",
      "type": "google",
      "costly": true,
      "description": "Selected address or place from the Google Places Autocomplete API.",
      "outputs": [
        { "variable": "selectedCoordinates", "path": "features.0.geometry.coordinates" },
        { "variable": "selectedAddress", "path": "features.0.properties.full_address" }
      ]
    }
  ]
}
