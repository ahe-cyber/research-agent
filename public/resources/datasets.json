[
  {
    "id": "mappluto",
    "name": "MAPPLUTO",
    "description": "Tax lot polygons and attributes from NYC Planning.",
    "type": "arcgis-feature-layer",
    "method": "GET",
    "overviewUrl": "https://services5.arcgis.com/GfwWNkhOj9bNBqoJ/arcgis/rest/services/MAPPLUTO/FeatureServer/0",
    "queryUrl": "https://services5.arcgis.com/GfwWNkhOj9bNBqoJ/arcgis/rest/services/MAPPLUTO/FeatureServer/0/query?geometryType=esriGeometryPoint&inSR=4326&spatialRel=esriSpatialRelIntersects&outFields=*&returnGeometry=true&outSR=4326&f=geojson",
    "defaultParams": [
      {
        "key": "geometry",
        "value": "selectedCoordinates"
      }
    ],
    "defaultOutputs": [
      {
        "variable": "plutoAddress",
        "path": "features.0.properties.Address"
      },
      {
        "variable": "plutoBbl",
        "path": "features.0.properties.BBL"
      },
      {
        "variable": "plutoBoroBlockLot",
        "path": "splitBBL(plutoBbl)"
      }
    ],
    "mapDisplay": {
      "supportsGeoJsonToggle": true,
      "geometryTypes": [
        "Polygon",
        "MultiPolygon"
      ]
    }
  },
  {
    "id": "curb-cut-2022",
    "name": "Curb Cut 2022",
    "description": "Curb cut features from an ArcGIS FeatureServer layer.",
    "type": "arcgis-feature-layer",
    "method": "GET",
    "overviewUrl": "https://services6.arcgis.com/yG5s3afENB5iO9fj/arcgis/rest/services/Curb_Cut_2022/FeatureServer/5",
    "queryUrl": "https://services6.arcgis.com/yG5s3afENB5iO9fj/arcgis/rest/services/Curb_Cut_2022/FeatureServer/5/query?geometryType=esriGeometryPoint&inSR=4326&spatialRel=esriSpatialRelIntersects&outFields=*&returnGeometry=true&outSR=4326&f=geojson&distance=100&units=esriSRUnit_Meter",
    "defaultParams": [
      {
        "key": "geometry",
        "value": "selectedCoordinates"
      }
    ],
    "defaultOutputs": [
      {
        "variable": "curbCutFirstProperties",
        "path": "features.0.properties"
      },
      {
        "variable": "curbCutCount",
        "path": "features.length"
      }
    ],
    "mapDisplay": {
      "supportsGeoJsonToggle": true,
      "geometryTypes": [
        "LineString"
      ]
    }
  },
  {
    "id": "source-mpmyo01p",
    "name": "Richmond County Clerk",
    "description": "Search documents in Richmond County Clerk office.",
    "type": "arcgis-feature-layer",
    "method": "GET",
    "overviewUrl": "",
    "queryUrl": "https://www.richmondcountyclerk.com/Search/ShowResultsBlocks",
    "defaultParams": [
      {
        "key": "Block",
        "value": "plutoBoroBlockLot.block"
      },
      {
        "key": "Lot",
        "value": "plutoBoroBlockLot.lot"
      }
    ],
    "defaultOutputs": [
      {
        "variable": "landDocTable",
        "path": "table"
      },
      {
        "variable": "landDocArray",
        "path": "tableToJson(landDocTable)"
      }
    ]
  },
  {
    "id": "source-mpn3uswb",
    "name": "Land Documents",
    "description": "Richmond County Clerk Land Documents",
    "type": "arcgis-feature-layer",
    "queryType": "pdf",
    "method": "GET",
    "overviewUrl": "",
    "queryUrl": "https://www.richmondcountyclerk.com/ViewVscmsDocument/ViewContent",
    "defaultParams": [
      {
        "key": "p_endorsementId",
        "value": "landDocArray.*.NUMBER"
      }
    ],
    "defaultOutputs": []
  }
]
